// The tests' own project: two D1 databases, whose schemas `d1-record schema` generates from these
// migrations and the Models in models/ (tests/integration/application-record.test.ts).
{
  "d1_databases": [
    { "binding": "DB", "database_name": "tests", "migrations_dir": "migrations/db" },
    { "binding": "LOGS", "database_name": "tests-logs", "migrations_dir": "migrations/logs" },
  ],
}
