---
// Above the home page's title, the orb and the site's name, in the same column as the title (the
// width Blume gives a centered page's article). The title below becomes the tagline, in a smaller
// size. Blume renders this slot above every page's article, so the other pages render nothing
// here.
import data from "blume:data";
import Logo from "./Logo.tsx";

interface Props {
  route: string;
}

const { route } = Astro.props;
---

{
  route === "/" && (
    <div class="mx-auto mb-3 flex max-w-[54rem] items-center gap-3" data-home-header>
      <div class="relative flex size-10 shrink-0" data-home-orb>
        <Logo size="lg" />
        <canvas
          aria-hidden="true"
          class="absolute inset-0 size-full opacity-0 transition-opacity duration-300 data-[drawn]:opacity-100"
        />
        <noscript>
          <style is:inline>
            [data-home-orb] > span {
              visibility: visible !important;
            }
          </style>
        </noscript>
      </div>
      <p class="font-display font-semibold text-4xl text-foreground tracking-[-0.05em] sm:text-5xl">
        {data.config.title}
      </p>
    </div>
  )
}

<script>
  // Blume swaps pages without reloading, so the orb starts on each arrival at the home page, once
  // per canvas, and stops before the page is swapped out. Every page loads this script, so the
  // orb's own code loads only once the home page shows, and only for readers who haven't asked
  // for reduced motion.
  const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");
  const start = async () => {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-home-orb] canvas:not([data-started])");
    if (!canvas || !motion.matches) return;
    canvas.dataset.started = "";
    const { startOrb } = await import("./orb.ts");
    // The reader may have left the home page while the code loaded.
    if (!canvas.isConnected) return;
    document.addEventListener("astro:before-swap", startOrb(canvas), { once: true });
  };
  start();
  document.addEventListener("astro:page-load", start);
  motion.addEventListener("change", start);
</script>

<style is:global>
  #blume-content:has([data-home-header]) article h1 {
    font-size: 1.875rem;
  }

  /* The orb fades in from transparent. The static logo shows instead for readers who ask for
     reduced motion, where the orb can't draw, and without JavaScript (the noscript above). */
  @media (prefers-reduced-motion: no-preference) {
    [data-home-orb]:not(:has(canvas[data-failed])) > span {
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-home-orb] > canvas {
      display: none;
    }
  }
</style>
