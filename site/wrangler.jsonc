// The documentation site: Blume's static build, served at d1-record.forestfuture.dev.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "d1-record-docs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "dist",
    // Blume writes each page as <route>/index.html and links to it without a trailing slash.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  // The custom domain is added once in the Cloudflare dashboard (docs/agents/cloudflare-tokens.md).
  "routes": [{ "pattern": "d1-record.forestfuture.dev", "custom_domain": true }],
}
