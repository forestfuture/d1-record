{
  // Examples are written as a Worker project would write them: bundler resolution and Workers
  // types. The package's own name comes from the root config's `paths`, mapped to src/.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "declaration": false
  },
  "include": ["."]
}
