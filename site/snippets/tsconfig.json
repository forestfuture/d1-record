{
  // Examples are written as a Worker project would write them: bundler resolution, Workers
  // types, and the package's own name, mapped here to the library's source.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": { "@forestfuture/d1-record": ["../../src/index.ts"] }
  },
  "include": ["."]
}
