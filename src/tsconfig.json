{
  // Library code runs on workerd: Workers types only, no Node types, so an
  // accidental Buffer or node:fs import fails type checking (see ADR-0002).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    // Declarations marked `/** @internal */` stay out of the published types.
    "stripInternal": true
  },
  "include": ["."]
}
