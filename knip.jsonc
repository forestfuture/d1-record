{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // The `d1-record` command: package.json's bin points at its build, dist/cli.mjs.
      "entry": ["cli/bin.ts"],
      // Generated schemas, committed as tests' fixtures: all of each is output, every table
      // exported as d1-record schema writes it.
      "ignore": [
        "tests/fixtures/schema-project/schema.ts",
        "tests/fixtures/DB.ts",
        "tests/fixtures/LOGS.ts",
      ],
      "typescript": {
        "config": [
          "tsconfig.json",
          "src/tsconfig.json",
          "cli/tsconfig.json",
          "tests/tsconfig.json",
        ],
      },
      "ignoreDependencies": ["@arethetypeswrong/core", "publint", "cloudflare"],
      // tests/integration/cli-console-command.test.ts lists a process's children with it.
      "ignoreBinaries": ["pgrep"],
    },
    "site": {
      // Examples reach pages through the excerpts the site's build writes, not through imports;
      // Blume loads its config and each group's meta.ts itself.
      "entry": ["snippets/**/*.ts", "blume.config.ts", "docs/**/meta.ts"],
    },
  },
}
