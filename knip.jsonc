{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "typescript": {
        "config": ["tsconfig.json", "src/tsconfig.json"],
      },
      "ignoreDependencies": ["@arethetypeswrong/core", "publint"],
    },
    "site": {
      // Examples are included into pages by Markdown (<<<), not imported.
      "entry": ["snippets/**/*.ts"],
    },
  },
}
