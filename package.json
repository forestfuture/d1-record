{
  "name": "@forestfuture/d1-record",
  "version": "0.0.0",
  "description": "A Rails-inspired Active Record for Cloudflare Workers and D1.",
  "keywords": [
    "active-record",
    "cloudflare",
    "d1",
    "orm",
    "sqlite",
    "workers"
  ],
  "homepage": "https://docs.forestfuture.dev/d1-record/",
  "bugs": {
    "url": "https://github.com/forestfuture/d1-record/issues"
  },
  "license": "MIT",
  "author": "ForestFuture (https://forestfuture.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forestfuture/d1-record.git"
  },
  "bin": {
    "d1-record": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "llms-full.txt",
    "SKILL.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:remote": "vp test --project remote",
    "check:public-types": "node scripts/check-public-types.mjs",
    "check:package": "node scripts/check-package.mjs",
    "bench:hydrate": "node scripts/bench/hydrate.ts",
    "check": "vp check",
    "prepack": "vp run build && vp run docs:build && node scripts/pack-docs.mjs",
    "release:version": "changeset version && vp fmt",
    "prepare": "vp config",
    "knip": "knip",
    "docs:dev": "vp run d1-record-site#dev",
    "docs:build": "vp run d1-record-site#build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^24.13.6",
    "knip": "^6.38.0",
    "miniflare": "^4.20260730.0",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "wrangler": "^4.147.0"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  }
}
